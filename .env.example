# Copier ce fichier vers .env puis renseigner les valeurs.

# --- Django (blueprint settings.py) ---
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- forge_auth ---
JWT_SIGNING_KEY=

# --- Base de données (forge configure postgres / mysql) ---
DB_NAME=forge_db
DB_USER=forge_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432  # 3306 pour MySQL

# --- Redis (forge configure redis / celery / channels) ---
REDIS_URL=redis://localhost:6379/0
